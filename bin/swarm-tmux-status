#!/bin/sh
# swarm-tmux-status: console table of the swarm tmux windows (tangentswarm.tmux_status).
# Runs this checkout's tangentswarm with the Python in $TANGENTSWARM_PYTHON (default: python3).
here=$(dirname "$(readlink -f "$0")")
PYTHONPATH="$here/..${PYTHONPATH:+:$PYTHONPATH}" exec "${TANGENTSWARM_PYTHON:-python3}" -m tangentswarm.tmux_status "$@"
